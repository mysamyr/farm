{
  "name": "@game/game-arena",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./client/index.ts",
    "./server": {
      "development": "./server/index.ts",
      "default": "./dist/server/index.js"
    },
    "./shared": {
      "development": "./shared/index.ts",
      "default": "./dist/shared/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p shared/tsconfig.json && tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p client/tsconfig.json"
  },
  "dependencies": {
    "@game/client-core": "*",
    "@game/shared": "*"
  }
}
